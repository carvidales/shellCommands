<% content_for :title, "#{@run.script.name} run" %>
<%= turbo_stream_from @run %>

<div class="actions">
  <%= link_to "← My scripts", root_path, class: "breadcrumb" %>
  <%= link_to "Edit script", edit_script_path(@run.script), class: "breadcrumb" %>
</div>

<div class="page-header">
  <div>
    <span class="eyebrow">Execution details</span>
    <h1><%= @run.script.name %></h1>
    <p class="page-subtitle">Started <%= l(@run.started_at, format: :long) %></p>
  </div>
  <% if @run.script.execution_form? && !@run.script.file_missing? %>
    <%= link_to "▶ Run again", parameters_script_path(@run.script), class: "button button-run" %>
  <% else %>
    <%= button_to "▶ Run again", run_script_path(@run.script), class: "button button-run", form_class: "inline-form",
          disabled: @run.script.file_missing? %>
  <% end %>
</div>

<div data-controller="run-log"
     data-run-log-length-value="<%= @run.log.length %>"
     data-run-log-url-value="<%= run_path(@run, format: :json) %>">
  <%= render "runs/status", run: @run %>

  <pre id="run_<%= @run.id %>_log" class="console" data-controller="autoscroll" data-run-log-target="log"><%= @run.log %></pre>
</div>

<details class="code-snapshot">
  <summary>Code that ran</summary>
  <pre class="code-editor"><%= @run.code_snapshot %></pre>
</details>
