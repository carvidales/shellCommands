<div class="card">
  <div class="card-heading">
    <% if script.icon? %>
      <%= image_tag icon_script_path(script), class: "script-icon", alt: "", width: 40, height: 40, loading: "lazy" %>
    <% end %>
    <div class="card-title"><%= script.name %></div>
  </div>
  <div class="card-meta">
    <% if script.file_missing? %>
      <span class="badge badge-missing">file missing</span>
    <% elsif (run = script.runs.first) %>
      last: <%= link_to "#{run_status_icon(run)} #{l(run.started_at, format: :short)}", run_path(run) %>
    <% else %>
      never run
    <% end %>
  </div>
  <div class="card-actions">
    <% if script.execution_form? && !script.file_missing? %>
      <%= link_to "▶ Run", parameters_script_path(script), class: "button button-run" %>
    <% else %>
      <%= button_to "▶ Run", run_script_path(script), class: "button button-run", form_class: "inline-form", disabled: script.file_missing? %>
    <% end %>
    <%= link_to "Edit", edit_script_path(script), class: "button button-secondary" %>
  </div>
</div>
